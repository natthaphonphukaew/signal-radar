# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
# Copy this file to .env and put your real key there — .env is git-ignored.
# NEVER put a real key in this file: .env.example IS committed to the repo.
GEMINI_API_KEY=your_key_here

# Optional: override the model if the free-tier model id changes.
# Check the current list at https://aistudio.google.com/
GEMINI_MODEL=gemini-3.6-flash
